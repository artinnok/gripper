# Absolute path to the SQLite database. Default: ~/.galloc/state.db.
# GALLOC_DATABASE_PATH=/absolute/path/state.db

# HTTP timeout in seconds for provider API requests.
GALLOC_API_TIMEOUT=30

# Startup wait limit and polling interval in seconds.
GALLOC_STARTUP_TIMEOUT=900
GALLOC_STARTUP_POLL_INTERVAL=2

# Request diagnostics and error tracebacks on stderr.
GALLOC_DEBUG=false

# Runpod API endpoint.
GALLOC_RUNPOD_API_URL=https://api.runpod.io/v2/

# Required only when using Runpod.
# GALLOC_RUNPOD_API_KEY=

# Runpod Pod creation defaults.
GALLOC_RUNPOD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
# Optional overrides for ~/.galloc/config.toml.
# GALLOC_DISK_GB=50
# GALLOC_SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
# GALLOC_RUNPOD_DISK_GB=50
# GALLOC_RUNPOD_SSH_PUBLIC_KEY=~/.ssh/runpod.pub
